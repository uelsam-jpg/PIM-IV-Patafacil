digraph Classes {
  graph [rankdir=LR, bgcolor="white", nodesep=0.45, ranksep=0.9, pad=0.3, dpi=220 ];
  node [shape=plain, fontname="Arial", fontsize=13];
  edge [fontname="Arial", fontsize=11, color="#4b5563", fontcolor="#4b5563", arrowsize=0.8];

  Pessoa [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><B>Pessoa</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+int Id<BR ALIGN="LEFT"/>+string Nome<BR ALIGN="LEFT"/>+string Cpf<BR ALIGN="LEFT"/>+string Email<BR ALIGN="LEFT"/>+bool Ativo<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+GetPerfil() : string  {abstrato}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Tutor [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Tutor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+string Telefone<BR ALIGN="LEFT"/>+string SenhaHash<BR ALIGN="LEFT"/>+DateTime DataCadastro<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+GetPerfil() : string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Funcionario [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Funcionario</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+Cargo Cargo<BR ALIGN="LEFT"/>+string SenhaHash<BR ALIGN="LEFT"/>+DateTime DataAdmissao<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+GetPerfil() : string<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Pet [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Pet</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+string Nome<BR ALIGN="LEFT"/>+Especie Especie<BR ALIGN="LEFT"/>+string Raca<BR ALIGN="LEFT"/>+decimal PesoKg<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Servico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Servico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+string Nome<BR ALIGN="LEFT"/>+int DuracaoMinutos<BR ALIGN="LEFT"/>+decimal Preco<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Agendamento [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Agendamento</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+DateTime DataHoraInicio<BR ALIGN="LEFT"/>+DateTime DataHoraFim<BR ALIGN="LEFT"/>-StatusAgendamento Status<BR ALIGN="LEFT"/>-DateTime? DataChegada<BR ALIGN="LEFT"/>-decimal? ValorPago<BR ALIGN="LEFT"/>-FormaPagamentoEnum? FormaPagamento<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+Confirmar()<BR ALIGN="LEFT"/>+Cancelar()<BR ALIGN="LEFT"/>+Concluir()<BR ALIGN="LEFT"/>+RegistrarChegada()<BR ALIGN="LEFT"/>+RegistrarPagamento(valor, forma)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HistoricoClinico [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>HistoricoClinico</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+TipoAtendimentoEnum Tipo<BR ALIGN="LEFT"/>+string Descricao<BR ALIGN="LEFT"/>+string Diagnostico<BR ALIGN="LEFT"/>+DateTime? ProximaVacina<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Venda [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Venda</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+DateTime DataVenda<BR ALIGN="LEFT"/>+decimal Total<BR ALIGN="LEFT"/>+FormaPagamentoEnum FormaPagamento<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ItemVenda [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>ItemVenda</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+int Quantidade<BR ALIGN="LEFT"/>+decimal PrecoUnitario<BR ALIGN="LEFT"/>+decimal Subtotal<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Produto [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Produto</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+string Nome<BR ALIGN="LEFT"/>+CategoriaProdutoEnum Categoria<BR ALIGN="LEFT"/>+decimal PrecoCusto<BR ALIGN="LEFT"/>+decimal PrecoVenda<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Estoque [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Estoque</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+int QuantidadeAtual<BR ALIGN="LEFT"/>+int PontoReposicao<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EntradaEstoque [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>EntradaEstoque</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+int Quantidade<BR ALIGN="LEFT"/>+string NumeroNota<BR ALIGN="LEFT"/>+string Fornecedor<BR ALIGN="LEFT"/>+DateTime? Validade<BR ALIGN="LEFT"/>+decimal CustoUnitario<BR ALIGN="LEFT"/>+decimal PrecoVendaAplicado<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Fornecedor [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>Fornecedor</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+string Nome<BR ALIGN="LEFT"/>+string Cnpj<BR ALIGN="LEFT"/>+string Telefone<BR ALIGN="LEFT"/>+string Email<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  EmailEnviado [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>EmailEnviado</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">+string Destinatario<BR ALIGN="LEFT"/>+string Assunto<BR ALIGN="LEFT"/>+DateTime DataEnvio<BR ALIGN="LEFT"/>+bool Lida<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Tutor -> Pessoa [arrowhead=onormal, arrowsize=1.2, constraint=false];
  Funcionario -> Pessoa [arrowhead=onormal, arrowsize=1.2, constraint=false];
  Pessoa -> Tutor [style=invis]; Pessoa -> Funcionario [style=invis];
  Tutor -> Pet [taillabel="1", headlabel="0..*", labeldistance=1.6, label=" possui ", arrowhead=vee];
  Pet -> Agendamento [taillabel="1", headlabel="0..*", labeldistance=1.6, arrowhead=vee];
  Servico -> Agendamento [taillabel="1", headlabel="0..*", labeldistance=1.6, arrowhead=vee];
  Funcionario -> Agendamento [taillabel="1", headlabel="0..*", labeldistance=1.6, label=" atende ", arrowhead=vee];
  Pet -> HistoricoClinico [taillabel="1", headlabel="0..*", labeldistance=1.6, arrowhead=vee];
  Agendamento -> HistoricoClinico [taillabel="0..1", headlabel="0..*", labeldistance=1.6, label=" gera ", arrowhead=vee];
  Funcionario -> Venda [taillabel="1", headlabel="0..*", labeldistance=1.6, label=" registra ", arrowhead=vee];
  Venda -> ItemVenda [taillabel="1", headlabel="1..*", labeldistance=1.6, dir=both, arrowtail=diamond, arrowhead=vee];
  Produto -> ItemVenda [taillabel="1", headlabel="0..*", labeldistance=1.6, arrowhead=vee];
  Produto -> Estoque [taillabel="1", headlabel="1", labeldistance=1.6, arrowhead=vee];
  Produto -> EntradaEstoque [taillabel="1", headlabel="0..*", labeldistance=1.6, label=" recebe ", arrowhead=vee];
  Funcionario -> EntradaEstoque [taillabel="1", headlabel="0..*", labeldistance=1.6, label=" confere ", arrowhead=vee];
  Fornecedor -> EntradaEstoque [taillabel="1", headlabel="0..*", labeldistance=1.6, label=" fornece ", style=dashed, arrowhead=vee];
  { rank=same; Fornecedor; EmailEnviado; }
}