digraph MER {
  graph [rankdir=TB, bgcolor="white", nodesep=0.45, ranksep=0.9, pad=0.3, dpi=220 ];
  node [shape=plain, fontname="Arial", fontsize=13];
  edge [fontname="Arial", fontsize=11, color="#4b5563", fontcolor="#4b5563", arrowsize=0.8];

  tutores [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>TUTORES</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Nome<BR ALIGN="LEFT"/>Cpf (UK)<BR ALIGN="LEFT"/>Email (UK)<BR ALIGN="LEFT"/>Telefone<BR ALIGN="LEFT"/>SenhaHash<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  pets [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>PETS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Nome<BR ALIGN="LEFT"/>Especie<BR ALIGN="LEFT"/>Raca<BR ALIGN="LEFT"/>PesoKg<BR ALIGN="LEFT"/>TutorId (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  funcionarios [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>FUNCIONARIOS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Nome<BR ALIGN="LEFT"/>Email (UK)<BR ALIGN="LEFT"/>Cargo<BR ALIGN="LEFT"/>SenhaHash<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  servicos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>SERVICOS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Nome<BR ALIGN="LEFT"/>DuracaoMinutos<BR ALIGN="LEFT"/>Preco<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  agendamentos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>AGENDAMENTOS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>DataHoraInicio<BR ALIGN="LEFT"/>DataHoraFim<BR ALIGN="LEFT"/>Status<BR ALIGN="LEFT"/>DataChegada<BR ALIGN="LEFT"/>ValorPago<BR ALIGN="LEFT"/>FormaPagamento<BR ALIGN="LEFT"/>IdPet (FK)<BR ALIGN="LEFT"/>IdServico (FK)<BR ALIGN="LEFT"/>IdFuncionario (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  log_agendamento_status [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>LOG_AGENDAMENTO_STATUS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>IdAgendamento (FK)<BR ALIGN="LEFT"/>StatusAnterior<BR ALIGN="LEFT"/>StatusNovo<BR ALIGN="LEFT"/>DataMudanca<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  historicos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>HISTORICOS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Tipo<BR ALIGN="LEFT"/>Descricao<BR ALIGN="LEFT"/>ProximaVacina<BR ALIGN="LEFT"/>IdPet (FK)<BR ALIGN="LEFT"/>IdFuncionario (FK)<BR ALIGN="LEFT"/>IdAgendamento (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  vendas [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>VENDAS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>DataVenda<BR ALIGN="LEFT"/>Total<BR ALIGN="LEFT"/>FormaPagamento<BR ALIGN="LEFT"/>IdTutor (FK)<BR ALIGN="LEFT"/>IdFuncionario (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  itensvenda [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>ITENSVENDA</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Quantidade<BR ALIGN="LEFT"/>PrecoUnitario<BR ALIGN="LEFT"/>Subtotal<BR ALIGN="LEFT"/>IdVenda (FK)<BR ALIGN="LEFT"/>IdProduto (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  produtos [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>PRODUTOS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Nome<BR ALIGN="LEFT"/>Categoria<BR ALIGN="LEFT"/>PrecoCusto<BR ALIGN="LEFT"/>PrecoVenda<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  estoques [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>ESTOQUES</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>QuantidadeAtual<BR ALIGN="LEFT"/>PontoReposicao<BR ALIGN="LEFT"/>IdProduto (FK, UK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  alerta_reposicao [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>ALERTA_REPOSICAO</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>IdProduto (FK)<BR ALIGN="LEFT"/>QuantidadeAtual<BR ALIGN="LEFT"/>Resolvido<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  entradas_estoque [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>ENTRADAS_ESTOQUE</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Quantidade<BR ALIGN="LEFT"/>NumeroNota<BR ALIGN="LEFT"/>Fornecedor<BR ALIGN="LEFT"/>Validade<BR ALIGN="LEFT"/>CustoUnitario<BR ALIGN="LEFT"/>IdProduto (FK)<BR ALIGN="LEFT"/>IdFuncionario (FK)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  fornecedores [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>FORNECEDORES</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Nome (UK)<BR ALIGN="LEFT"/>Cnpj<BR ALIGN="LEFT"/>Telefone<BR ALIGN="LEFT"/>Email<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  emails [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" COLOR="#20b2aa" BGCOLOR="white"><TR><TD BGCOLOR="#e6f6f5" CELLPADDING="6"><B>EMAILS</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="6">Id (PK)<BR ALIGN="LEFT"/>Destinatario<BR ALIGN="LEFT"/>Assunto<BR ALIGN="LEFT"/>DataEnvio<BR ALIGN="LEFT"/>Lida<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  tutores -> pets [label=" possui ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  pets -> agendamentos [label=" agenda ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  servicos -> agendamentos [label=" define ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  funcionarios -> agendamentos [label=" atende ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  agendamentos -> log_agendamento_status [label=" registra ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  pets -> historicos [label=" tem ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  funcionarios -> historicos [label=" registra ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  agendamentos -> historicos [label=" origina ", taillabel="0..1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  tutores -> vendas [label=" compra ", taillabel="0..1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  funcionarios -> vendas [label=" registra ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  vendas -> itensvenda [label=" contém ", taillabel="1", headlabel="1..N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  produtos -> itensvenda [label=" vendido em ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  produtos -> estoques [label=" saldo ", taillabel="1", headlabel="1", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  produtos -> alerta_reposicao [label=" alerta ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  produtos -> entradas_estoque [label=" recebe ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  funcionarios -> entradas_estoque [label=" confere ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both];
  fornecedores -> entradas_estoque [label=" fornece (pelo nome) ", taillabel="1", headlabel="N", labeldistance=1.8, arrowhead=crow, arrowtail=tee, dir=both, style=dashed];
  { rank=same; fornecedores; emails; }
}